@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: Apache-2.0
+// Fleet hack (AgX hackday): when this page is shown inside a fleet page's iframe, the fleet page
+// can send commands to this tractor and read its position. Only active inside a frame.
+//   in : { fleet: 'cmd', cmd: 'field.openOnly|FleetField' }
+//   out: { fleet: 'state', e, n, heading, speed, originLat, originLon, hasField, fieldName, control }
+(function () {
+  if (window.parent === window) return;
+  window.addEventListener('message', ev => {
+    const d = ev.data;
+    if (d && d.fleet === 'cmd' && typeof d.cmd === 'string') transport.send(d.cmd);
+  });
+  setInterval(() => {
+    const p = tick && tick.pose;
+    window.parent.postMessage({
+      fleet: 'state',
+      e: p ? p.e : null, n: p ? p.n : null, heading: p ? p.heading : null, speed: p ? p.speed : null,
+      originLat: scene ? scene.originLat : null, originLon: scene ? scene.originLon : null,
+      hasField: !!(scene && scene.hasField), fieldName: scene ? scene.fieldName : '',
+      control: !!iHoldControl,
+    }, '*');
+  }, 500);
+})();
