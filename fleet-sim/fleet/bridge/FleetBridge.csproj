<Project Sdk="Microsoft.NET.Sdk">

  <!-- Three virtual tractors (AgOpenWeb VirtualModuleHub) in one process.
       Each sends $PANDA GPS sentences over UDP; the Python coordinator drives them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AgOpenWeb\Simulators\AgOpenWeb.VirtualModules\AgOpenWeb.VirtualModules.csproj" />
  </ItemGroup>

</Project>
